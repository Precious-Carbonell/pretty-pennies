# ---------------------------------------------------------------------------
# Dependencies & build output
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Personal money data — NEVER commit any of this.
# The app keeps your ledger in the browser's IndexedDB (on-device, encrypted),
# so it normally never touches the repo. These rules are a safety net for
# exported backups or any data files that land in the project folder.
# ---------------------------------------------------------------------------
pretty-pennies-backup*.json
*backup*.json
*ledger*.json
*.ledger
data/
backups/
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# Secrets & environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets*.json

# ---------------------------------------------------------------------------
# Logs & caches
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/

# ---------------------------------------------------------------------------
# Editor & OS junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.local
.idea/
.vscode/*
!.vscode/extensions.json
